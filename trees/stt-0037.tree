\date{2024-09-16}
\author{fredrikbakke}
\taxon{Proposition}
\import{common}
\title{Closure properties right adjoint left inverses}

\p{
  \ol{
    \li{Equivalences are one-sided inverse transposing adjunctions.}
    \li{One-sided inverse transposing adjunctions compose.}
    % \li{One-sided inverse transposing adjunctions are closed under retracts of maps.}
    \li{One-sided inverse transposing adjunctions are closed under base change along maps #{j} such that the transposition map #{\hom_A(L(j(x)),a)\to \hom_B(j(x),R(a))} is an equivalence.}
  }
}

\proof{\ol{
  \li{Follows by the corresponding [closure property of transposing adjunctions](stt-0034).}
  \li{Transposing adjunctions and one-sided inverses compose.}
  % \li{Transposing adjunctions and one-sided inverses are closed under retracts of maps.}
