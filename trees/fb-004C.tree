\date{2024-07-27}
\taxon{Proposition}
\author{fredrikbakke}
\import{common}

\p{If cubes separate then simplices separate. I.e., if the restrictions to #{n}-cubes of a simplicial and crisp map #{f :_{\flat} A \to B} are equivalences, then the restrictions to #{n}-simplices #{f_n : A_n \to B_n} are also.}
