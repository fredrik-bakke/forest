\date{2024-07-26}
\taxon{Axiom}
\author{fredrikbakke}
\title{Cubes separate}
\meta{source}{Axiom 8 in [[GWB24]]}
\import{common}

\p{A map #{f \colon-flat A \to B} is an [[hott-000U]] if and only if the map
##{\modflat{f \o \blank} \colon \modflat{(\directed-interval)^n \to A} \to \modflat{(\directed-interval)^n \to B}}
is an equivalence for all #{n :^{\flat} \bN}, where \directed-interval is the directed interval.}
