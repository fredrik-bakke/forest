% Be sure to register all LaTeX packages in gh-pages.yml
\def\latex-preamble/diagrams{
\startverb
\usepackage{tikz, tikz-cd, quiver, babel, mathtools, amsmath, amssymb, stmaryrd, bbold}
\usetikzlibrary{matrix,arrows}
\usetikzlibrary{decorations.markings}
\usetikzlibrary{babel}

\tikzset{
  pullback/.style={minimum size=1.2ex,path picture={
  \draw[opacity=1,black,-,#1] (-0.6ex,-0.3ex) -- (0.0ex,-0.3ex) -- (0.0ex,0.3ex);%
}}}

\tikzset{
  pushout/.style={minimum size=1.2ex,path picture={
  \draw[opacity=1,black,-,#1] (-0.0ex,-0.3ex) -- (-0.0ex,0.3ex) -- (0.6ex,0.3ex);%
}}}
\stopverb
}

\def\latex-preamble/inference{
\startverb
\usepackage{mathtools, amssymb, stmaryrd, bbold, mathpartir, proof}
\stopverb
}
