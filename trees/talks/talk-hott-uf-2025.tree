\title{The Cantor–Schröder–Bernstein Theorem in ∞-topoi}
\taxon{Contributed talk}
\author{fredrikbakke}
\import{common}
\date{2025-04-15}
\meta{venue}{[HoTT/UF 2025](https://hott-uf.github.io/2025/), Genoa, Italy}
