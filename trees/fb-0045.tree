\date{2024-07-26}
\taxon{Definition}
\author{fredrikbakke}
\title{#{♭}-orthogonal maps}
\meta{source}{[[MR23]]}
\import{common}

\p{
  Given two crisp maps #{f \colon-flat A \to B} and #{g \colon-flat X \to Y}, we say #{g} is
  \concept{#{\flat}-orthogonal} to #{f}, written #{f \orthogonal_\flat g}, if any of the following equivalent conditions hold

  \ol{
    \li{
      Every crisp square

      \tikzcd{
        A \arrow[d,"f"'] \arrow[r]& X \arrow[d,"g"] \\
        B\arrow[r] & Y
      }

      factorizes uniquely through a crisp map #{B \to X}.
    }

    \li{
      The #{\flat}-[pullback-power](hott-0006) ##{f\pullback-power_\flat g \colon \modflat{B \to X} \to \modflat{B \to Y}\times_{\modflat{A \to Y}}\modflat{A \to X}} is an [[hott-000U]].
    }

    \li{
      The flat exponential square

      \tikzcd{
        \modflat{B \to X} \arrow[d, "\modflat{g \o\blank}"'] \arrow[r, "\modflat{\blank\o f}"]
        & \modflat{A \to X}\arrow[d, "\modflat{g \o\blank}"]  \\
        \modflat{B \to Y}\arrow[r, "\modflat{\blank\o f}"']
        & \modflat{A \to Y}
      }
      is a pullback.
    }

    \li{
      The dependent precomposition map
      ##{\modflat{\blank\o f} \colon \modflat{(y : B) \to \fiber{g}{h(y)}}\to\modflat{(x : A)\to \fiber{g}{h(f(x))}}}

      is an [[hott-000U]] for all #{h \colon-flat B \to Y}.
    }
  }

  We extend the concept of #{\flat}-orthogonality to crisp types by substituting them for their terminal projections, and to crisp type families by substituting them for their total space projections.
}
