{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pre-commit",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "group": {
        "kind": "test"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "process",
      "command": "make",
      "args": ["build"],
      "group": {
        "kind": "build"
      },
      "hide": true
    },
    {
      "label": "clean",
      "type": "process",
      "command": "make",
      "args": ["clean"],
      "group": {
        "kind": "build"
      },
      "hide": true
    },
    {
      "label": "clean-and-build",
      "dependsOn": ["clean", "build"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "watch",
      "type": "process",
      "command": "make",
      "args": ["watch"],
      "isBackground": true,
      "problemMatcher": [],
      "group": "test",
      "hide": true,
      "presentation": {
        "reveal": "always",
        "revealProblems": "onProblem",
        "close": false
      }
    },
    {
      "label": "serve",
      "dependsOn": "build",
      "command": "${command:livePreview.start}",
      "hide": true,
      "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "serve-and-watch",
      "dependsOrder": "sequence",
      "dependsOn": ["serve", "watch"],
      "isBackground": true,
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
