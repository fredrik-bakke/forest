{
  // Hide build artefacts explorer view
  "files.exclude": {
    "MAlonzo/": true,
    "**/MAlonzo/": true,
    "_build/": true,
    "_opam/": true,
    "_tmp/": true
  },
  "files.associations": {
    "codespellrc": "toml",
    ".codespellrc": "toml"
  },
  // Autoformatting
  "editor.formatOnType": true,
  "editor.formatOnSave": true,
  "editor.useEditorConfig": true,
  "editor.detectIndentation": false,
  "editor.rulers": [85],

  "editor.insertSpaces": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,

  "[agda][forester][lagda-forester]": {
    "editor.detectIndentation": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": true
  },
  "[makefile]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.renderWhitespace": "boundary"
  },
  "latex-workshop.latex.autoBuild.run": "never",
  "livePreview.defaultPreviewPath": "output/forest/index.html",
  "livePreview.autoRefreshPreview": "On All Changes in Editor",
  "livePreview.portNumber": 1313,
  "livePreview.serverRoot": "output",
  "livePreview.previewDebounceDelay": 300,
  "forester.config": "forest.toml"
}
