\date{2024-09-12}
\author{fredrikbakke}
\taxon{Proposition}
\import{common}
\title{Closure properties of transposing adjunctions between simplicial types}

\p{
  \ol{
    \li{Equivalences are transposing adjunctions.}
    \li{Transposing adjunctions compose.}
    \li{Transposing adjunctions are closed under retracts of maps.}
  }
}

\proof{

  (See agda-unimath formalization)
